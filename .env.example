# --- Service identity ---
SERVICE_NAME=tracemind-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
# "postgres" for the real pool, "simulated" to run without a database.
DB_BACKEND=postgres
DATABASE_URL=postgresql://tracemind:tracemind@localhost:5432/tracemind
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=2.0

# --- Inter-service URLs (docker-compose service names) ---
ORDER_SERVICE_URL=http://order-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000
USER_SERVICE_URL=http://user-service:8000

# --- Fault injection (payment-service) ---
# none | db_conn_leak
PAYMENT_FAULT_MODE=none

# --- Telemetry ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true

# --- Ingestion / normalization (Phase 2) ---
# Tolerance (ms) when ordering events whose clocks may differ slightly.
EVENT_TIME_TOLERANCE_MS=200
# Events ingested later than this (seconds) are flagged, not dropped.
LATE_EVENT_THRESHOLD_SECONDS=60.0
# event_time ahead of ingestion_time by more than this (ms) suggests clock skew.
CLOCK_SKEW_THRESHOLD_MS=500
# Window (seconds) within which identical events are treated as duplicates.
DEDUP_WINDOW_SECONDS=300.0

# --- Correlation / graph (Phase 3) ---
# Max gap (seconds) between a log and a candidate span for an inferred link.
CORRELATION_WINDOW_SECONDS=30.0
# Max gap (seconds) between alerts that may be grouped into one incident.
ALERT_GROUP_WINDOW_SECONDS=300.0
# Alerts may be grouped across services up to this many CALLS hops.
ALERT_GROUP_MAX_HOPS=2
# Sliding-window size/step (seconds) for streaming-style correlation (I7).
SLIDING_WINDOW_SECONDS=300.0
SLIDING_WINDOW_STEP_SECONDS=60.0
